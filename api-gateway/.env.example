# Database Credentials
MYSQL_ROOT_PASSWORD=change_me_root_password
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me_auth_password
PROFILE_DB_USER=profile_user
PROFILE_DB_PASSWORD=change_me_profile_password
DOCTOR_PROFILE_DB_USER=doctor_profile_user
DOCTOR_PROFILE_DB_PASSWORD=change_me_doctor_profile_password
DOCTOR_PATIENT_DB_USER=doctor_patient_user
DOCTOR_PATIENT_DB_PASSWORD=change_me_doctor_patient_password
RECORDS_DB_USER=records_user
RECORDS_DB_PASSWORD=change_me_records_password
ALERTS_DB_USER=alerts_user
ALERTS_DB_PASSWORD=change_me_alerts_password

# JWT Secret (must be the same across all services)
JWT_SECRET_KEY=change_me_to_a_strong_random_secret

# Internal API Key (for service-to-service communication)
INTERNAL_API_KEY=change_me_to_a_strong_random_key

# Email / SMTP (Gmail App Password — required for OTP verification)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password_here
